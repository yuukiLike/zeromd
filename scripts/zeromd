#!/bin/bash
# zeromd CLI — 查看同步状态、手动同步、健康检查
set -euo pipefail

REAL_PATH="$(readlink "$0" 2>/dev/null || echo "$0")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_PATH")" && pwd)"
STATE_DIR="${ZEROMD_STATE_DIR:-$HOME/.zeromd}"

# ---------- 工具函数 ----------

# 将语言标签归一化为 CLI 支持的语言。cn 仅作为中文的精确别名。
normalize_language() {
    local value
    value=$(printf '%s' "$1" | tr '[:upper:]' '[:lower:]')

    case "$value" in
        cn|zh|zh_*|zh-*|zh.*) echo "zh" ;;
        en|en_*|en-*|en.*)    echo "en" ;;
        ja|ja_*|ja-*|ja.*)    echo "ja" ;;
        *) return 1 ;;
    esac
}

# 读取 macOS 的有序首选语言，返回第一个 CLI 支持的语言。
macos_preferred_language() {
    local preferred_languages language normalized

    command -v osascript >/dev/null 2>&1 || return 1
    preferred_languages=$(osascript -l JavaScript -e '
ObjC.import("Foundation")
var preferred = $.NSLocale.preferredLanguages
var languages = []
for (var i = 0; i < preferred.count; i++) {
    languages.push(ObjC.unwrap(preferred.objectAtIndex(i)))
}
languages.join("\n")
' 2>/dev/null) || return 1

    while IFS= read -r language; do
        if normalized=$(normalize_language "$language"); then
            echo "$normalized"
            return 0
        fi
    done <<EOF
$preferred_languages
EOF

    return 1
}

# 解析语言：显式参数 > ZEROMD_LANG > macOS 首选语言 > 终端 locale > 英文
resolve_language() {
    local requested="${1:-}" resolved locale_value

    if [ -n "$requested" ]; then
        normalize_language "$requested"
        return
    fi

    if [ -n "${ZEROMD_LANG:-}" ]; then
        normalize_language "$ZEROMD_LANG" || echo "en"
        return
    fi

    if resolved=$(macos_preferred_language); then
        echo "$resolved"
        return
    fi

    locale_value="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
    normalize_language "$locale_value" || echo "en"
}

# help / doctor 支持显式 LANG
command_language() {
    case "$#" in
        0) resolve_language "" ;;
        1) resolve_language "$1" ;;
        *) return 1 ;;
    esac
}

language_error() {
    local lang
    lang=$(resolve_language "")
    say "$lang" \
        "语言: 请使用 zh / cn / en / ja" \
        "Language: use zh / cn / en / ja" \
        "言語: zh / cn / en / ja を使用してください" >&2
}

say() {
    local lang="$1" zh_text="$2" en_text="$3" ja_text="$4"
    case "$lang" in
        zh) printf '%s\n' "$zh_text" ;;
        ja) printf '%s\n' "$ja_text" ;;
        *)  printf '%s\n' "$en_text" ;;
    esac
}

# 将秒数转为人类可读的时间差
human_time() {
    local seconds=$1 lang="${2:-en}"
    case "$lang" in
        zh)
            if [ "$seconds" -lt 60 ]; then
                echo "${seconds}秒前"
            elif [ "$seconds" -lt 3600 ]; then
                echo "$(( seconds / 60 ))分钟前"
            elif [ "$seconds" -lt 86400 ]; then
                echo "$(( seconds / 3600 ))小时前"
            else
                echo "$(( seconds / 86400 ))天前"
            fi
            ;;
        ja)
            if [ "$seconds" -lt 60 ]; then
                echo "${seconds}秒前"
            elif [ "$seconds" -lt 3600 ]; then
                echo "$(( seconds / 60 ))分前"
            elif [ "$seconds" -lt 86400 ]; then
                echo "$(( seconds / 3600 ))時間前"
            else
                echo "$(( seconds / 86400 ))日前"
            fi
            ;;
        *)
            if [ "$seconds" -lt 60 ]; then
                echo "${seconds}s ago"
            elif [ "$seconds" -lt 3600 ]; then
                echo "$(( seconds / 60 ))min ago"
            elif [ "$seconds" -lt 86400 ]; then
                echo "$(( seconds / 3600 ))h ago"
            else
                echo "$(( seconds / 86400 ))d ago"
            fi
            ;;
    esac
}

# 读取 vault 路径
get_vault_dir() {
    if [ -f "$STATE_DIR/vault-path" ]; then
        cat "$STATE_DIR/vault-path"
    else
        echo ""
    fi
}

# 读取 vault 名（basename）
get_vault_name() {
    local vpath
    vpath="$(get_vault_dir)"
    if [ -n "$vpath" ]; then
        basename "$vpath"
    else
        echo "?"
    fi
}

# ---------- 子命令 ----------

cmd_status() {
    local now vault_name pending=0
    now=$(date +%s)
    vault_name="$(get_vault_name)"

    # pending 变更数
    local vault_dir
    vault_dir="$(get_vault_dir)"
    if [ -n "$vault_dir" ] && [ -d "$vault_dir/.git" ]; then
        pending=$(git -C "$vault_dir" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
    fi

    # 心跳检查
    local heartbeat_age=-1
    if [ -f "$STATE_DIR/last-heartbeat" ]; then
        local hb
        hb=$(cat "$STATE_DIR/last-heartbeat")
        heartbeat_age=$(( now - hb ))
    fi

    # 错误检查
    local last_error=""
    if [ -f "$STATE_DIR/last-error" ]; then
        last_error=$(cat "$STATE_DIR/last-error")
    fi

    # daemon 状态
    if [ "$heartbeat_age" -eq -1 ] || [ "$heartbeat_age" -gt 600 ]; then
        # daemon 可能挂了
        if [ "$heartbeat_age" -eq -1 ]; then
            echo "⚠ daemon not running · no heartbeat · vault: $vault_name"
        else
            echo "⚠ daemon not running · last seen $(human_time $heartbeat_age) · vault: $vault_name"
        fi
        return
    fi

    # 有错误
    if [ -n "$last_error" ]; then
        echo "✗ sync error: $last_error · $pending pending · vault: $vault_name"
        return
    fi

    # 正常：显示上次同步时间
    if [ -f "$STATE_DIR/last-sync" ]; then
        local ls_epoch sync_age
        ls_epoch=$(cat "$STATE_DIR/last-sync")
        sync_age=$(( now - ls_epoch ))
        echo "✓ synced $(human_time $sync_age) · $pending pending · vault: $vault_name"
    else
        echo "✓ daemon running · no sync yet · $pending pending · vault: $vault_name"
    fi
}

cmd_log() {
    local n="${1:-20}"
    local log_file="$STATE_DIR/sync.log"
    if [ ! -f "$log_file" ]; then
        echo "No log file found at $log_file"
        return 1
    fi
    tail -n "$n" "$log_file"
}

cmd_sync() {
    local rc=0 last_error=""
    bash "$SCRIPT_DIR/sync.sh" || rc=$?

    echo ""
    if [ "$rc" -eq 0 ]; then
        cmd_status
        return 0
    fi

    if [ -s "$STATE_DIR/last-error" ]; then
        last_error="$(cat "$STATE_DIR/last-error" 2>/dev/null || true)"
    fi

    echo "✗ sync failed (exit code: $rc)" >&2
    if [ -n "$last_error" ]; then
        echo "  Error: $last_error" >&2
    fi
    echo "  Details: gmd log" >&2
    echo "  Diagnose: gmd doctor" >&2

    return "$rc"
}

cmd_doctor() {
    local lang
    if ! lang="$(command_language "$@")"; then
        language_error
        return 2
    fi

    echo "gmd doctor"

    local vault_dir
    vault_dir="$(get_vault_dir)"

    # 1. vault path
    if [ -n "$vault_dir" ] && [ -d "$vault_dir" ]; then
        say "$lang" \
            "  ✓ Vault 路径存在: $vault_dir" \
            "  ✓ Vault path exists: $vault_dir" \
            "  ✓ Vault パスが存在します: $vault_dir"
    else
        say "$lang" \
            "  ✗ Vault 路径不存在或未配置" \
            "  ✗ Vault path missing or not configured" \
            "  ✗ Vault パスが存在しないか未設定です"
    fi

    # 2. .git directory
    if [ -n "$vault_dir" ] && [ -d "$vault_dir/.git" ]; then
        say "$lang" \
            "  ✓ Git 仓库正常" \
            "  ✓ Git repo OK" \
            "  ✓ Git リポジトリは正常です"
    else
        say "$lang" \
            "  ✗ Git 仓库不存在" \
            "  ✗ Git repo not found" \
            "  ✗ Git リポジトリが見つかりません"
    fi

    # 3. remote
    if [ -n "$vault_dir" ] && [ -d "$vault_dir/.git" ]; then
        local remote_url
        remote_url=$(git -C "$vault_dir" remote get-url origin 2>/dev/null || echo "")
        if [ -n "$remote_url" ]; then
            say "$lang" \
                "  ✓ Git remote 已配置: $remote_url" \
                "  ✓ Git remote configured: $remote_url" \
                "  ✓ Git リモートを設定済みです: $remote_url"
        else
            say "$lang" \
                "  ✗ Git remote 未配置" \
                "  ✗ Git remote not configured" \
                "  ✗ Git リモートが未設定です"
        fi
    fi

    # 4. launchd
    if launchctl list 2>/dev/null | grep -q zeromd; then
        say "$lang" \
            "  ✓ launchd 任务运行中" \
            "  ✓ launchd job running" \
            "  ✓ launchd ジョブが実行中です"
    else
        say "$lang" \
            "  ✗ launchd 任务未运行" \
            "  ✗ launchd job not running" \
            "  ✗ launchd ジョブが実行されていません"
    fi

    # 5. heartbeat
    if [ -f "$STATE_DIR/last-heartbeat" ]; then
        local now hb age age_text
        now=$(date +%s)
        hb=$(cat "$STATE_DIR/last-heartbeat")
        age=$(( now - hb ))
        age_text=$(human_time "$age" "$lang")
        if [ "$age" -le 600 ]; then
            say "$lang" \
                "  ✓ 上次心跳: $age_text" \
                "  ✓ Last heartbeat: $age_text" \
                "  ✓ 前回のハートビート: $age_text"
        else
            say "$lang" \
                "  ⚠ 上次心跳: ${age_text}（超过 10 分钟）" \
                "  ⚠ Last heartbeat: $age_text (over 10 min)" \
                "  ⚠ 前回のハートビート: ${age_text}（10分超）"
        fi
    else
        say "$lang" \
            "  ⚠ 无心跳记录" \
            "  ⚠ No heartbeat recorded" \
            "  ⚠ ハートビートの記録がありません"
    fi

    # 6. last sync error
    if [ -f "$STATE_DIR/last-error" ]; then
        local err
        err=$(cat "$STATE_DIR/last-error")
        if [ -n "$err" ]; then
            say "$lang" \
                "  ✗ 上次同步失败: $err" \
                "  ✗ Last sync failed: $err" \
                "  ✗ 前回の同期に失敗しました: $err"
        else
            say "$lang" \
                "  ✓ 上次同步正常" \
                "  ✓ Last sync OK" \
                "  ✓ 前回の同期は正常です"
        fi
    else
        say "$lang" \
            "  ✓ 无同步错误" \
            "  ✓ No sync errors" \
            "  ✓ 同期エラーはありません"
    fi

    # 7. .git directory size (warn above 300 MiB)
    if [ -n "$vault_dir" ] && [ -d "$vault_dir/.git" ]; then
        local git_size
        git_size=$(du -sh "$vault_dir/.git" 2>/dev/null | cut -f1)
        local size_kib
        size_kib=$(du -sk "$vault_dir/.git" 2>/dev/null | cut -f1)
        if [ "${size_kib:-0}" -gt 307200 ]; then
            say "$lang" \
                "  ⚠ .git 目录较大: $git_size" \
                "  ⚠ .git directory large: $git_size" \
                "  ⚠ .git ディレクトリが大きいです: $git_size"
        else
            say "$lang" \
                "  ✓ .git 目录大小: $git_size" \
                "  ✓ .git directory size: $git_size" \
                "  ✓ .git ディレクトリのサイズ: $git_size"
        fi
    fi

    # 8. iCloud placeholder files
    if [ -n "$vault_dir" ] && [ -d "$vault_dir" ]; then
        local icloud_count
        icloud_count=$(find "$vault_dir" -name "*.icloud" 2>/dev/null | wc -l | tr -d ' ')
        if [ "$icloud_count" -gt 0 ]; then
            say "$lang" \
                "  ⚠ 发现 .icloud 占位文件: ${icloud_count} 个" \
                "  ⚠ Found .icloud placeholders: ${icloud_count}" \
                "  ⚠ .icloud プレースホルダが見つかりました: ${icloud_count}個"
        else
            say "$lang" \
                "  ✓ 无 .icloud 占位文件" \
                "  ✓ No .icloud placeholders" \
                "  ✓ .icloud プレースホルダはありません"
        fi
    fi

    # 9. rebase in progress
    if [ -n "$vault_dir" ] && [ -d "$vault_dir/.git" ]; then
        if [ -d "$vault_dir/.git/rebase-merge" ] || [ -d "$vault_dir/.git/rebase-apply" ]; then
            say "$lang" \
                "  ✗ Git rebase 中断中，需手动处理" \
                "  ✗ Git rebase in progress, manual resolution needed" \
                "  ✗ Git rebase が進行中です。手動での解決が必要です"
        else
            say "$lang" \
                "  ✓ 无 rebase 中断" \
                "  ✓ No rebase in progress" \
                "  ✓ 進行中の rebase はありません"
        fi
    fi
}

cmd_setup() {
    exec bash "$SCRIPT_DIR/setup.sh"
}

cmd_init() {
    exec bash "$SCRIPT_DIR/setup.sh"
}

cmd_help() {
    local lang
    if ! lang="$(command_language "$@")"; then
        language_error
        return 2
    fi

    if [ "$lang" = "zh" ]; then
        cat <<'EOF'
gmd — iCloud Obsidian vault 的 Git 同步工具

用法: gmd <command>

命令:
  status          同步状态（默认）
  sync            立即同步
  log [N]         最近 N 行日志（默认 20）
  doctor [LANG]   健康检查
  setup | init    安装或重新配置
  help [LANG]     显示帮助

语言: 默认跟随系统；LANG: zh / cn / en / ja
md 是 gmd 的兼容别名。
文档: https://github.com/yuukiLike/zeromd/blob/main/README.zh.md
EOF
    elif [ "$lang" = "ja" ]; then
        cat <<'EOF'
gmd — iCloud 上の Obsidian Vault 用 Git 同期ツール

使い方: gmd <command>

コマンド:
  status          同期状態（デフォルト）
  sync            今すぐ同期
  log [N]         最近の N 行のログ（デフォルト: 20）
  doctor [LANG]   ヘルスチェック
  setup | init    インストールまたは再設定
  help [LANG]     ヘルプを表示

言語: システム設定に従います。LANG: zh / cn / en / ja
md は gmd の互換エイリアスです。
ドキュメント: https://github.com/yuukiLike/zeromd/blob/main/README.ja.md
EOF
    else
        cat <<'EOF'
gmd — Git sync for iCloud Obsidian vaults

Usage: gmd <command>

Commands:
  status          Sync status (default)
  sync            Sync now
  log [N]         Last N log lines (default: 20)
  doctor [LANG]   Health check
  setup | init    Install or reconfigure
  help [LANG]     Show help

Language: follows system settings; LANG: zh / cn / en / ja
md remains a compatibility alias for gmd.
Docs: https://github.com/yuukiLike/zeromd#readme
EOF
    fi
}

# ---------- 分发 ----------

command_name="${1:-status}"
if [ "$#" -gt 0 ]; then
    shift
fi

case "$command_name" in
    status)  cmd_status "$@" ;;
    log)     cmd_log "${1:-}" ;;
    sync)    cmd_sync "$@" ;;
    doctor)  cmd_doctor "$@" ;;
    setup)   cmd_setup "$@" ;;
    init)    cmd_init "$@" ;;
    help|--help|-h)  cmd_help "$@" ;;
    *)
        lang="$(resolve_language "")"
        say "$lang" \
            "未知命令: $command_name" \
            "Unknown command: $command_name" \
            "不明なコマンド: $command_name"
        echo ""
        cmd_help "$lang"
        exit 1
        ;;
esac
